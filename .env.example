# Copy to .env and configure ONLY a separate LINA development database.
# This URL is an example, not a working credential.
DATABASE_URL="postgresql://lina_app:CHANGE_ME@127.0.0.1:5432/lina_dev?schema=public"

# Next.js sets NODE_ENV for dev/build/start. Do not set production for local dev.
# NODE_ENV=development

# Required: canonical browser origin, without trailing slash. HTTPS required except loopback.
LINA_ORIGIN="http://localhost:3000"

# Required runtime secret. Keep stable across all instances and restarts.
# Generate an independent 32-byte secret, encoded as 64 hexadecimal characters.
CLIENT_CREDENTIAL_PEPPER=

# Optional for text-only startup; required to upload/read attachments. Absolute private path.
# ATTACHMENT_STORAGE_DIR="/absolute/private/path/lina-uploads"
