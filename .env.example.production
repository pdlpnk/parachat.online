# Template only. Store the real file OUTSIDE releases: /srv/lina/shared/lina.env
# Owner lina:lina, mode 0600. Never commit or paste real values into chat/logs.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3107

# Separate LINA role/database; URL-encode the password if not hexadecimal.
DATABASE_URL="postgresql://lina_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/lina_prod?schema=public"
# Exact browser HTTPS origin: no trailing slash, path, or alternate hostname.
LINA_ORIGIN="https://lina.example.com"
# REQUIRED: independent 32-byte secret, exactly 64 hexadecimal characters.
# Generate ONCE and preserve with encrypted backups. Do not rotate on redeploy.
CLIENT_CREDENTIAL_PEPPER="CHANGE_ME_64_HEX_CHARACTERS"
