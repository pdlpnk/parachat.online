# Safe example for the NEW standalone chat-only site. Never copy production secrets.
NODE_ENV=production
APP_NAME="VX House Chat"
APP_PORT=3000
NEXT_PUBLIC_SITE_URL=https://chat.example.com

DATABASE_URL=postgresql://chat_app:CHANGE_ME@127.0.0.1:5432/vx_chat?sslmode=require
DIRECT_URL=postgresql://chat_migrator:CHANGE_ME@127.0.0.1:5432/vx_chat?sslmode=require

# Generate independent random values; do not reuse VX House secrets.
CLIENT_TOKEN_PEPPER=CHANGE_ME_64_HEX_OR_LONG_RANDOM
ADMIN_SESSION_PEPPER=CHANGE_ME_DIFFERENT_64_HEX_OR_LONG_RANDOM
MESSAGE_ENCRYPTION_KEY=CHANGE_ME_IF_MESSAGE_ENCRYPTION_IS_ENABLED

CLIENT_COOKIE_NAME=__Host-vx_client
ADMIN_COOKIE_NAME=__Host-vx_admin
CLIENT_SESSION_DAYS=180
ADMIN_IDLE_MINUTES=60
ADMIN_ABSOLUTE_HOURS=24

TRUST_PROXY_HEADERS=true
UPLOAD_DRIVER=filesystem
UPLOAD_DIRECTORY=/opt/vx-chat/uploads
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
